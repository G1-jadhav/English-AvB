{
  "name": "english-avb",
  "version": "1.0.0",
  "description": "Mobile-First Real-Time Multiplayer English Quiz Web Application",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"yellow,cyan\" \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "server": "node --watch server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix server install"
  },
  "keywords": [
    "english",
    "quiz",
    "multiplayer",
    "real-time",
    "socket.io",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
